@page "/visitors"
@attribute [Authorize(Roles = "Admin,User")]

@using VisitorManagement.Web.Models.Visitors
@inject VisitorApiService VisitorApiService

<PageTitle>Visitors - Visitor Management</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">
    Visitor Records
</MudText>

<MudText Typo="Typo.body1" Class="mb-4">
    Search, sort, and view registered visitors.
</MudText>

<MudPaper Elevation="2" Class="pa-4 mb-4">

    <MudGrid Spacing="3" AlignItems="AlignItems.Center">

        <MudItem xs="12" md="5">
            <MudTextField T="string"
                          Label="Search by Visitor Name"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          DebounceInterval="400"
                          Value="@_searchText"
                          ValueChanged="OnSearchChanged"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true" />
        </MudItem>

        <MudItem xs="12" md="3">
            <MudSelect T="string"
                       Label="Sort By"
                       Variant="Variant.Outlined"
                       Value="@_sortBy"
                       ValueChanged="OnSortChanged">

                <MudSelectItem T="string" Value="@("VisitDate")">
                    Visit Date
                </MudSelectItem>

                <MudSelectItem T="string" Value="@("VisitorName")">
                    Visitor Name
                </MudSelectItem>

            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="2">
            <MudSelect T="bool"
                       Label="Order"
                       Variant="Variant.Outlined"
                       Value="@_descending"
                       ValueChanged="OnOrderChanged">

                <MudSelectItem T="bool" Value="true">
                    Descending
                </MudSelectItem>

                <MudSelectItem T="bool" Value="false">
                    Ascending
                </MudSelectItem>

            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       FullWidth="true"
                       OnClick="RefreshAsync"
                       StartIcon="@Icons.Material.Filled.Refresh">
                Refresh
            </MudButton>
        </MudItem>

    </MudGrid>

</MudPaper>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @_errorMessage
    </MudAlert>
}

<MudPaper Elevation="2" Class="pa-4">

    <MudTable T="VisitorResponse"
              Items="@_visitors"
              Loading="@_isLoading"
              Hover="true"
              Dense="true"
              Striped="true"
              Breakpoint="Breakpoint.Md">

        <HeaderContent>
            <MudTh>Visitor Name</MudTh>
            <MudTh>Company</MudTh>
            <MudTh>Mobile</MudTh>
            <MudTh>Visit Date</MudTh>
            <MudTh>Host</MudTh>
            <MudTh>Purpose</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Visitor Name">
                @context.VisitorName
            </MudTd>

            <MudTd DataLabel="Company">
                @context.CompanyName
            </MudTd>

            <MudTd DataLabel="Mobile">
                @context.MobileNumber
            </MudTd>

            <MudTd DataLabel="Visit Date">
                @context.VisitDate.ToString("dd MMM yyyy, hh:mm tt")
            </MudTd>

            <MudTd DataLabel="Host">
                @context.HostName
            </MudTd>

            <MudTd DataLabel="Purpose">
                @context.PurposeName
            </MudTd>

            <MudTd DataLabel="Status">
                <MudChip T="string"
                         Color="@GetStatusColor(context.Status)"
                         Size="Size.Small">
                    @context.Status
                </MudChip>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            @if (!_isLoading && string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudText Class="pa-4">
                    No visitor records found.
                </MudText>
            }
        </NoRecordsContent>

        <LoadingContent>
            <MudText Class="pa-4">
                Loading visitor records...
            </MudText>
        </LoadingContent>

    </MudTable>

    <MudDivider Class="my-4" />

    <MudGrid AlignItems="AlignItems.Center">

        <MudItem xs="12" sm="4">
            <MudText Typo="Typo.body2">
                Total records: @_totalCount
            </MudText>
        </MudItem>

        <MudItem xs="12" sm="4">
            <MudSelect T="int"
                       Label="Records Per Page"
                       Variant="Variant.Outlined"
                       Value="@_pageSize"
                       ValueChanged="OnPageSizeChanged">

                <MudSelectItem T="int" Value="5">5</MudSelectItem>
                <MudSelectItem T="int" Value="10">10</MudSelectItem>
                <MudSelectItem T="int" Value="20">20</MudSelectItem>

            </MudSelect>
        </MudItem>

        <MudItem xs="12" sm="4">
            <MudPagination Count="@Math.Max(1, _totalPages)"
                           Selected="@_page"
                           SelectedChanged="OnPageChanged"
                           Disabled="@_isLoading" />
        </MudItem>

    </MudGrid>

</MudPaper>

@code {
    private IReadOnlyList<VisitorResponse> _visitors =
        Array.Empty<VisitorResponse>();

    private string _searchText = string.Empty;
    private string _sortBy = "VisitDate";
    private bool _descending = true;

    private int _page = 1;
    private int _pageSize = 10;
    private int _totalCount;
    private int _totalPages;

    private bool _isLoading;
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadVisitorsAsync();
    }

    private async Task LoadVisitorsAsync()
    {
        _isLoading = true;
        _errorMessage = string.Empty;

        try
        {
            var request = new VisitorSearchRequest
                {
                    Search = _searchText,
                    SortBy = _sortBy,
                    Descending = _descending,
                    Page = _page,
                    PageSize = _pageSize
                };

            var result = await VisitorApiService.SearchAsync(request);

            _visitors = result.Items;
            _totalCount = result.TotalCount;
            _totalPages = result.TotalPages;
        }
        catch (Exception)
        {
            _visitors = Array.Empty<VisitorResponse>();
            _totalCount = 0;
            _totalPages = 0;

            _errorMessage =
                "Unable to load visitor records. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnSearchChanged(string value)
    {
        _searchText = value ?? string.Empty;
        _page = 1;
        await LoadVisitorsAsync();
    }

    private async Task OnSortChanged(string value)
    {
        _sortBy = value;
        _page = 1;
        await LoadVisitorsAsync();
    }

    private async Task OnOrderChanged(bool value)
    {
        _descending = value;
        _page = 1;
        await LoadVisitorsAsync();
    }

    private async Task OnPageSizeChanged(int value)
    {
        _pageSize = value;
        _page = 1;
        await LoadVisitorsAsync();
    }

    private async Task OnPageChanged(int value)
    {
        _page = value;
        await LoadVisitorsAsync();
    }

    private async Task RefreshAsync()
    {
        await LoadVisitorsAsync();
    }

    private static Color GetStatusColor(string status)
    {
        return status switch
        {
            "Scheduled" => Color.Info,
            "CheckedIn" => Color.Success,
            "Completed" => Color.Default,
            "Cancelled" => Color.Error,
            _ => Color.Default
        };
    }
}