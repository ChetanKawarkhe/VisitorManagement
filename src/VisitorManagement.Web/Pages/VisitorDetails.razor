@page "/visitors/{Id:int}"
@attribute [Authorize(Roles = "Admin,User")]

@using Microsoft.AspNetCore.Components.Authorization
@using VisitorManagement.Web.Models.Visitors

@inject VisitorApiService VisitorApiService
@inject NavigationManager NavigationManager

<PageTitle>Visitor Details</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    Visitor Details
</MudText>

@if (_isLoading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <MudAlert Severity="Severity.Error">
        @_errorMessage
    </MudAlert>
}
else if (_visitor is not null)
{
    <MudPaper Elevation="2" Class="pa-6">

        <MudGrid Spacing="3">

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2">Visitor Name</MudText>
                <MudText>@_visitor.VisitorName</MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2">Company</MudText>
                <MudText>@_visitor.CompanyName</MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2">Mobile Number</MudText>
                <MudText>@_visitor.MobileNumber</MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2">Email</MudText>
                <MudText>@(_visitor.Email ?? "-")</MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2">Visit Date</MudText>
                <MudText>@_visitor.VisitDate.ToString("dd MMM yyyy, hh:mm tt")</MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2">Host</MudText>
                <MudText>@_visitor.HostName</MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2">Purpose</MudText>
                <MudText>@_visitor.PurposeName</MudText>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2">Status</MudText>
                <MudChip T="string"
                         Color="@GetStatusColor(_visitor.Status)"
                         Size="Size.Small">
                    @_visitor.Status
                </MudChip>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2">Remarks</MudText>
                <MudText>@(_visitor.Remarks ?? "-")</MudText>
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-3" />

                <MudStack Row="true" Spacing="2">

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               OnClick="GoBack">
                        Back to Visitors
                    </MudButton>

                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="GoToEdit">
                                Edit Visitor
                            </MudButton>
                        </Authorized>
                    </AuthorizeView>

                </MudStack>

            </MudItem>

        </MudGrid>

    </MudPaper>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private VisitorResponse? _visitor;
    private bool _isLoading = true;
    private string _errorMessage = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _isLoading = true;
        _errorMessage = string.Empty;

        try
        {
            _visitor = await VisitorApiService.GetByIdAsync(Id);

            if (_visitor is null)
            {
                _errorMessage = "Visitor record was not found.";
            }
        }
        catch (Exception)
        {
            _errorMessage =
                "Unable to load visitor details. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/visitors");
    }

    private void GoToEdit()
    {
        NavigationManager.NavigateTo($"/visitors/{Id}/edit");
    }

    private static Color GetStatusColor(string status)
    {
        return status switch
        {
            "Scheduled" => Color.Info,
            "CheckedIn" => Color.Success,
            "Completed" => Color.Default,
            "Cancelled" => Color.Error,
            _ => Color.Default
        };
    }
}