@page "/login"

<PageTitle>Login - Visitor Management</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small"
              Class="mt-8">

    <MudPaper Elevation="3"
              Class="pa-8">

        <MudText Typo="Typo.h5"
                 GutterBottom="true">
            Sign In
        </MudText>

        <MudText Typo="Typo.body2"
                 Class="mb-4">
            Login functionality will be implemented in Part 3.
        </MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="true"
                   FullWidth="true">
            Sign In
        </MudButton>

    </MudPaper>

</MudContainer>