@inherits LayoutComponentBase

@inject AuthenticationService AuthenticationService
@inject NavigationManager NavigationManager

<MudThemeProvider />

<MudPopoverProvider />

<MudDialogProvider />

<MudSnackbarProvider />

<MudLayout>

    <MudAppBar Elevation="1"
               Color="Color.Primary">

        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick="@ToggleDrawer" />

        <MudText Typo="Typo.h6">
            Employee Visitor Management
        </MudText>

        <MudSpacer />

        <AuthorizeView>

            <Authorized>

                <MudText Typo="Typo.body2"
                         Class="mr-3">
                    @context.User.Identity?.Name
                </MudText>

                <MudButton Variant="Variant.Text"
                           Color="Color.Inherit"
                           OnClick="HandleLogoutAsync">
                    Logout
                </MudButton>

            </Authorized>

            <NotAuthorized>

                <MudButton Variant="Variant.Text"
                           Color="Color.Inherit"
                           Href="/login">
                    Login
                </MudButton>

            </NotAuthorized>

        </AuthorizeView>

    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Elevation="1"
               Variant="DrawerVariant.Responsive">

        <MudDrawerHeader>

            <MudText Typo="Typo.h6"
                     Color="Color.Primary">
                Visitor Management
            </MudText>

        </MudDrawerHeader>

        <MudNavMenu>

            <MudNavLink Href="/"
                        Match="NavLinkMatch.All"
                        Icon="@Icons.Material.Filled.Home">
                Dashboard
            </MudNavLink>

            <AuthorizeView>

                <Authorized>

                    <MudNavLink Href="/visitors"
                                Icon="@Icons.Material.Filled.People">
                        Visitors
                    </MudNavLink>

                </Authorized>

            </AuthorizeView>

            <AuthorizeView Roles="Admin">

                <Authorized>

                    <MudNavLink Href="/visitors/create"
                                Icon="@Icons.Material.Filled.PersonAdd">
                        Register Visitor
                    </MudNavLink>

                </Authorized>

            </AuthorizeView>

            <AuthorizeView>

                <NotAuthorized>

                    <MudNavLink Href="/login"
                                Icon="@Icons.Material.Filled.Login">
                        Login
                    </MudNavLink>

                </NotAuthorized>

            </AuthorizeView>

        </MudNavMenu>

    </MudDrawer>

    <MudMainContent Class="pa-6">

        <MudContainer MaxWidth="MaxWidth.ExtraLarge">

            @Body

        </MudContainer>

    </MudMainContent>

</MudLayout>

@code {

    private bool _drawerOpen = true;

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task HandleLogoutAsync()
    {
        await AuthenticationService.LogoutAsync();

        NavigationManager.NavigateTo("/login");
    }
}